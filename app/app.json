{
  "expo": {
    "name": "EquityHub",
    "slug": "equityhub",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "equityhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.equityhub.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock EquityHub with Face ID.",
        "NSPhotoLibraryUsageDescription": "Attach a payment screenshot or a KYC document.",
        "NSCameraUsageDescription": "Photograph a KYC document."
      }
    },
    "android": {
      "package": "com.equityhub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 3
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "apiBaseUrl": "https://equityhub.live",
      "wsUrl": "wss://equityhub.live/ws",
      "webOrigin": "https://equityhub.live"
    },
    "icon": "./assets/icon.png"
  }
}
