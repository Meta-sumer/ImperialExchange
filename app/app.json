{
  "expo": {
    "name": "Imperial Exchange",
    "slug": "imperialexchange",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "imperialexchange",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#010D25"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imperialexchange.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Imperial Exchange with Face ID.",
        "NSPhotoLibraryUsageDescription": "Attach a payment screenshot or a KYC document.",
        "NSCameraUsageDescription": "Photograph a KYC document."
      }
    },
    "android": {
      "package": "com.imperialexchange.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010D25"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "apiBaseUrl": "https://imperialexchange.in",
      "wsUrl": "wss://imperialexchange.in/ws",
      "webOrigin": "https://imperialexchange.in"
    },
    "icon": "./assets/icon.png"
  }
}
