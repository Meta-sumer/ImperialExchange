    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.7",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.16",
