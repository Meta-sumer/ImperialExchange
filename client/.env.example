VITE_API_URL=/api
VITE_WS_URL=ws://179.197.249.237/ws
# Public-facing origin used when generating shareable referral / reset
# links. If unset the FE falls back to window.location.origin (fine for
# dev; in production set this so links don't say "localhost").
VITE_PUBLIC_URL=https://imperialexchange.in

# Production build — set via Docker --build-arg, not via this file:
#   docker build --build-arg VITE_API_URL=https://imperialexchange.in/api \
#                --build-arg VITE_WS_URL=wss://imperialexchange.in/ws \
#                --build-arg VITE_PUBLIC_URL=https://imperialexchange.in \
#                -t tp-client .
