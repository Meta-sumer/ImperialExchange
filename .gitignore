# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
.cache/

# Environment files
.env
.env.local
.env.*.local

# Upstox auto-refreshed access token (secret — never commit)
.upstox-token.json
backend/.upstox-token.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User uploads (KYC docs etc - never commit these)
uploads/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Testing
coverage/

# Misc
.npm
.eslintcache

# Archives
*.tar
*.tar.gz
*.zip

# Database backups and dumps hold every user's data - never commit them.
# (mongo-backup/ is already tracked from May 2026; ignoring it here stops NEW
# files only — untracking it is a separate, deliberate step.)
mongo-backups/
mongo-backup/
dump/
*.archive.gz
*.bson
*.bson.gz

*.bak

# Agent worktrees (local only)
.claude/worktrees/
